---
import Base from '../layouts/Base.astro';
import { t, localePath, locales } from '../i18n';

const primary = t('me');
---

<Base
  locale="me"
  path="/404/"
  title={`${primary.notFound.title} · Mandarina`}
  description={primary.notFound.body}
  showBookingBar={false}
  noindex
>
  <section class="not-found section">
    <div class="container">
      {
        locales.map((code) => {
          const tr = t(code);
          return (
            <div class="not-found__block" lang={tr.langTag}>
              <p class="not-found__code">404</p>
              <h1 class="not-found__title">{tr.notFound.title}</h1>
              <p class="not-found__body">{tr.notFound.body}</p>
              <a class="text-link" href={localePath[code]}>
                {tr.notFound.back}
              </a>
            </div>
          );
        })
      }
    </div>
  </section>
</Base>

<style>
  .not-found .container {
    display: grid;
    gap: 3rem;
  }

  .not-found__title {
    font-size: var(--text-h2);
  }

  .not-found__code {
    margin-bottom: 1rem;
    color: var(--c-burnt);
    font-size: var(--text-sm);
  }

  .not-found__body {
    margin: 1rem 0 1.5rem;
    color: var(--c-ink-soft);
  }

  @media (min-width: 48em) {
    .not-found .container {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
