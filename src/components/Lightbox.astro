---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale).gallery.lightbox;
---

<dialog class="lightbox" id="lightbox" aria-label={tr.dialogLabel} data-of={tr.of}>
  <div class="lightbox__bar">
    <p class="lightbox__counter" data-lb-counter aria-live="polite"></p>
    <button class="lightbox__btn" type="button" data-lb-close>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
        <path d="M3 3l12 12M15 3 3 15" fill="none" stroke="currentColor" stroke-width="1.6"></path>
      </svg>
      <span>{tr.close}</span>
    </button>
  </div>

  <figure class="lightbox__figure">
    <img class="lightbox__image" data-lb-image alt="" sizes="100vw" decoding="async" />
    <figcaption class="lightbox__caption" data-lb-caption></figcaption>
  </figure>

  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lb-prev aria-label={tr.prev}>
    <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
      <path d="M14 4l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    </svg>
  </button>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lb-next aria-label={tr.next}>
    <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
      <path d="M8 4l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    </svg>
  </button>
</dialog>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c-ink);
    color: var(--c-ink-on-dark);
    display: none;
    grid-template-rows: auto 1fr;
    touch-action: pan-y;
  }

  .lightbox[open] {
    display: grid;
  }

  .lightbox::backdrop {
    background: rgba(20, 18, 14, 0.7);
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: max(0.5rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) 0.5rem
      max(1rem, env(safe-area-inset-left));
  }

  .lightbox__counter {
    margin: 0;
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--c-ink-on-dark) 75%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .lightbox__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    background: none;
    border: 1px solid color-mix(in srgb, var(--c-ink-on-dark) 30%, transparent);
    border-radius: var(--radius);
    color: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  .lightbox__btn:hover {
    border-color: var(--c-ink-on-dark);
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 0;
    padding: 0.5rem max(1rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom))
      max(1rem, env(safe-area-inset-left));
    gap: 0.75rem;
  }

  .lightbox__image {
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
    min-height: 0;
    background: transparent;
    -webkit-user-drag: none;
  }

  .lightbox__caption {
    margin: 0;
    text-align: center;
    color: color-mix(in srgb, var(--c-ink-on-dark) 80%, transparent);
    font-size: var(--text-sm);
    padding-bottom: 3.25rem;
  }

  .lightbox__nav {
    position: absolute;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    width: 3rem;
    height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--c-ink-on-dark) 30%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-ink) 70%, transparent);
    color: var(--c-ink-on-dark);
    cursor: pointer;
  }

  .lightbox__nav:hover {
    border-color: var(--c-ink-on-dark);
  }

  .lightbox__nav--prev {
    left: max(1rem, env(safe-area-inset-left));
  }

  .lightbox__nav--next {
    right: max(1rem, env(safe-area-inset-right));
  }

  .lightbox :focus-visible {
    outline-color: var(--c-paper);
  }

  @media (min-width: 64em) {
    .lightbox__figure {
      padding-inline: 5rem;
    }

    .lightbox__caption {
      padding-bottom: 0;
    }

    .lightbox__nav {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
      width: 3.25rem;
      height: 3.25rem;
    }

    .lightbox__nav--prev {
      left: 1.25rem;
    }

    .lightbox__nav--next {
      right: 1.25rem;
    }
  }
</style>
