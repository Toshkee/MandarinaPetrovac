---
// Astro adaptation of Sona UI's Magnetic Button. See THIRD-PARTY-NOTICES.md.
interface Props {
  href: string;
  external?: boolean;
  class?: string;
}
const { href, external = false, class: className } = Astro.props;
---

<a
  class:list={['btn btn--primary magnetic-link', className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-magnetic
>
  <span class="magnetic-link__label"><slot /></span>
  <span class="magnetic-link__arrow" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<style>
  .magnetic-link {
    gap: 1.25rem;
    padding: 0.6rem 0.6rem 0.6rem 1.5rem;
    min-height: 3.5rem;
  }

  .magnetic-link__label {
    translate: var(--magnetic-x, 0px) var(--magnetic-y, 0px);
    transition: translate 360ms var(--ease);
  }

  .magnetic-link__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 14%);
    transition: background var(--dur) var(--ease);
  }

  .magnetic-link:hover .magnetic-link__arrow {
    background: rgb(255 255 255 / 24%);
  }

  @media (prefers-reduced-motion: reduce) {
    .magnetic-link__label {
      translate: none;
      transition: none;
    }
    .magnetic-link__arrow { transition: none; }
  }
</style>

<script>
  import '../scripts/magnetic';
</script>
