---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { property } from '../config/property';
import { media } from '../content/media';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const photo = media.petrovacDusk;
---

<section class="location section section--sand" id={tr.anchors.location} aria-labelledby="location-title">
  <div class="container">
    <div class="location__head">
      <SectionHead title={tr.location.title} id="location-title" lede={tr.location.body[0]} />
    </div>

    <figure class="location__figure">
      <div class="frame frame--16x9" style={`--focal: ${photo.focal.x}% ${photo.focal.y}%`}>
        <Picture
          src={photo.src}
          alt={photo.alt[locale]}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="(min-width: 80rem) 80rem, 100vw"
          layout="full-width"
          loading="lazy"
        />
      </div>
      <figcaption>{photo.caption[locale]}</figcaption>
    </figure>

    <div class="location__grid">
      <div class="location__text">
        <div class="location__body prose">
          <p>{tr.location.body[1]}</p>
        </div>
      </div>

      <aside class="location__aside" aria-labelledby="location-practical">
        <h3 id="location-practical" class="location__aside-title">{tr.location.practicalHeading}</h3>
        <p class="location__address">{tr.location.address}</p>
        <ul class="location__list">
          {tr.location.practical.map((item) => <li>{item}</li>)}
        </ul>
        <a class="text-link location__map" href={property.links.map} target="_blank" rel="noopener noreferrer">
          {tr.location.mapCta}
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M3 8h9m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
          <span class="sr-only">({tr.footer.externalNote})</span>
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .location__head {
    max-width: 58rem;
  }

  .location__figure {
    margin-top: 2.5rem;
  }

  .location__grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .location__body {
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .location__aside {
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line-strong);
  }

  .location__aside-title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }

  .location__list {
    margin-top: 1rem;
  }

  .location__address {
    margin-top: 0.7rem;
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    line-height: 1.2;
  }

  .location__list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--c-line);
    line-height: 1.4;
  }

  .location__map {
    margin-top: 1.5rem;
  }

  @media (min-width: 64em) {
    .location__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(3rem, 8vw, 8rem);
      align-items: start;
    }

  }
</style>
