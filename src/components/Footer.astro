---
import Wordmark from './Wordmark.astro';
import { property } from '../config/property';
import { t, localePath, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const year = new Date().getFullYear();
const hasContact = Boolean(property.contact.email || property.contact.phone);
---

<footer class="site-footer" data-booking-bar-stop>
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Wordmark href={localePath[locale]} label={tr.nav.home} onDark />
      <p class="site-footer__tagline">{tr.footer.tagline}</p>
    </div>

    <ul class="site-footer__links">
      <li>
        <a href={property.links.instagram} target="_blank" rel="noopener noreferrer">
          {tr.footer.instagram}
          <span class="sr-only">({tr.footer.externalNote})</span>
        </a>
      </li>
      <li>
        <a href={property.links.booking} target="_blank" rel="noopener noreferrer">
          Booking.com
          <span class="sr-only">({tr.footer.externalNote})</span>
        </a>
      </li>
      {
        property.links.airbnb && (
          <li>
            <a href={property.links.airbnb} target="_blank" rel="noopener noreferrer">
              Airbnb
              <span class="sr-only">({tr.footer.externalNote})</span>
            </a>
          </li>
        )
      }
    </ul>

    {
      hasContact && (
        <address class="site-footer__contact">
          <span class="site-footer__label">{tr.footer.contactHeading}</span>
          {property.contact.email && <a href={`mailto:${property.contact.email}`}>{property.contact.email}</a>}
          {property.contact.phone && (
            <a href={`tel:${property.contact.phone.replace(/\s+/g, '')}`}>{property.contact.phone}</a>
          )}
        </address>
      )
    }

    <nav class="site-footer__lang" aria-label={tr.footer.languages}>
      <span class="site-footer__label">{tr.footer.languages}</span>
      <ul>
        {
          locales.map((code) => (
            <li>
              <a
                href={localePath[code]}
                hreflang={t(code).langTag}
                lang={t(code).langTag}
                aria-current={code === locale ? 'page' : undefined}
              >
                {t(code).langName}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} {property.fullName} · {property.location.town}, {property.location.country[locale]}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-ink);
    color: var(--c-ink-on-dark);
    padding-block: 3.5rem 2rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--c-tangerine-on-dark);
  }

  .site-footer :focus-visible {
    outline-color: var(--c-paper);
  }

  .site-footer__grid {
    display: grid;
    gap: 2.25rem;
  }

  .site-footer__tagline {
    margin-top: 0.75rem;
    color: color-mix(in srgb, var(--c-ink-on-dark) 70%, transparent);
    font-size: var(--text-sm);
  }

  .site-footer__label {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c-ink-on-dark) 60%, transparent);
    margin-bottom: 0.5rem;
  }

  .site-footer__links li,
  .site-footer__lang li {
    padding: 0;
  }

  .site-footer__links a,
  .site-footer__lang a,
  .site-footer__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 500;
  }

  .site-footer__lang a[aria-current='page'] {
    color: var(--c-tangerine-on-dark);
  }

  .site-footer__contact {
    font-style: normal;
    display: grid;
  }

  .site-footer__bottom {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--c-ink-on-dark) 18%, transparent);
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--c-ink-on-dark) 65%, transparent);
  }

  @media (min-width: 48em) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
      column-gap: 2rem;
    }
  }

  @media (min-width: 64em) {
    .site-footer__grid {
      grid-template-columns: 3fr 1fr 1fr 1fr;
    }
  }
</style>
