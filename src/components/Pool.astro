---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { media } from '../content/media';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const pool = media.poolSeaView;
const building = media.buildingPoolOlive;
---

<section class="pool section" id={tr.anchors.pool} aria-labelledby="pool-title">
  <div class="container pool__grid">
    <div class="pool__text">
      <SectionHead title={tr.pool.title} id="pool-title" />
      <p class="pool__body">{tr.pool.body}</p>
      <ul class="pool__points">
        {tr.pool.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>

    <figure class="pool__figure pool__figure--pool" data-reveal>
      <div class="frame pool__frame" style={`--focal: ${pool.focal.x}% ${pool.focal.y}%`}>
        <Picture
          src={pool.src}
          alt={pool.alt[locale]}
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1320, 1620, 1980]}
          sizes="(min-width: 64em) 56vw, 100vw"
          layout="full-width"
          loading="lazy"
        />
      </div>
      <figcaption>{pool.caption[locale]}</figcaption>
    </figure>

    <figure class="pool__figure pool__figure--building">
      <div class="frame frame--4x3" style={`--focal: ${building.focal.x}% ${building.focal.y}%`}>
        <Picture
          src={building.src}
          alt={building.alt[locale]}
          formats={['avif', 'webp']}
          widths={[480, 720, 1024]}
          sizes="(min-width: 64em) 34vw, 100vw"
          layout="full-width"
          loading="lazy"
        />
      </div>
      <figcaption>{building.caption[locale]}</figcaption>
    </figure>
  </div>
</section>

<style>
  /* The pool is the showpiece: a deep sea-blue band with the pool photograph bleeding to the edge. */
  .pool {
    background: var(--c-adriatic);
    color: var(--c-paper);
    overflow: hidden;
  }

  .pool__grid {
    display: grid;
    gap: 2rem;
  }

  .pool__body {
    margin-top: 1.5rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--c-ink-on-dark);
    max-width: 40ch;
  }

  .pool__points {
    display: grid;
    margin-top: 1.75rem;
  }

  .pool__points li {
    padding: 0.7rem 0;
    border-top: 1px solid color-mix(in srgb, var(--c-paper) 25%, transparent);
    font-size: var(--text-sm);
    color: var(--c-paper);
  }

  .pool__frame {
    aspect-ratio: 4 / 5;
    background: color-mix(in srgb, var(--c-adriatic) 70%, black);
  }

  .pool figcaption {
    color: color-mix(in srgb, var(--c-paper) 78%, transparent);
  }

  .pool :focus-visible {
    outline-color: var(--c-paper);
  }

  @media (min-width: 48em) {
    .pool__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .pool__text {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64em) {
    .pool__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: 2.5rem;
      align-items: start;
    }

    .pool__figure--pool {
      --bleed: max(var(--gutter), (100vw - var(--container)) / 2);
      grid-column: 1 / 8;
      grid-row: 1 / 3;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      /* Bleed to the left edge of the viewport, keep the right corners rounded. */
      margin-left: calc(-1 * var(--bleed));
    }

    .pool__figure--pool .frame {
      flex: 1;
      aspect-ratio: auto;
      min-height: 36rem;
      max-height: 52rem;
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }

    .pool__figure--pool figcaption {
      margin-left: var(--bleed);
    }

    .pool__text {
      grid-column: 8 / 13;
      grid-row: 1;
      padding-top: 1rem;
    }

    .pool__figure--building {
      grid-column: 8 / 13;
      grid-row: 2;
    }
  }
</style>
