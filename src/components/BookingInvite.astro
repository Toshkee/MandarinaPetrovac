---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import MagneticLink from './MagneticLink.astro';
import logo from '../assets/brand/mandarina-sunset-logo.jpg';
import { property } from '../config/property';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
---

<section
  class="booking section"
  id={tr.anchors.booking}
  aria-labelledby="booking-title"
  data-booking-bar-stop
>
  <div class="container booking__inner" data-reveal>
    <div class="booking__seal">
      <Image
        src={logo}
        alt={property.fullName}
        width={144}
        height={144}
        densities={[1, 2]}
        format="webp"
        loading="lazy"
        class="booking__logo"
      />
    </div>
    <div class="booking__text">
      <SectionHead title={tr.booking.title} id="booking-title" />
      <p class="booking__body">{tr.booking.body}</p>
      <div class="booking__actions">
        <MagneticLink
          href={property.links.booking}
          external
        >
          {tr.booking.bookingCta}
          <span class="sr-only">({tr.footer.externalNote})</span>
        </MagneticLink>
        {
          property.links.airbnb && (
            <a class="btn btn--ghost" href={property.links.airbnb} target="_blank" rel="noopener noreferrer">
              {tr.booking.airbnbCta}
              <span class="sr-only">({tr.footer.externalNote})</span>
            </a>
          )
        }
      </div>
      <p class="booking__instagram">
        {tr.booking.instagramLead}
        <a href={property.links.instagram} target="_blank" rel="noopener noreferrer">
          @{property.links.instagramHandle}
          <span class="sr-only">({tr.footer.externalNote})</span>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .booking {
    background: var(--c-peach);
  }

  .booking__inner {
    display: grid;
    gap: 2rem;
  }

  .booking__seal {
    width: 7rem;
    rotate: -8deg;
  }

  .booking__logo {
    border-radius: 50%;
    width: 100%;
    height: auto;
  }

  .booking__body {
    margin-top: 1.5rem;
    font-size: var(--text-lg);
    max-width: 42ch;
  }

  .booking__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .booking__actions :global(.btn) {
    width: 100%;
  }

  .booking__instagram {
    margin-top: 1.75rem;
    color: var(--c-ink-soft);
  }

  .booking__instagram a {
    color: var(--c-ink);
    font-weight: 500;
  }

  @media (min-width: 40em) {
    .booking__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .booking__actions :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 64em) {
    .booking__inner {
      grid-template-columns: minmax(0, 1fr) 12rem;
      column-gap: 4rem;
      align-items: center;
    }

    .booking__text {
      grid-column: 1;
      grid-row: 1;
    }

    .booking__seal {
      width: 12rem;
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
