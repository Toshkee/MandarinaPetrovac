---
import SectionHead from './SectionHead.astro';
import CitrusMark from './CitrusMark.astro';
import { property } from '../config/property';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
---

<section
  class="booking section"
  id={tr.anchors.booking}
  aria-labelledby="booking-title"
  data-booking-bar-stop
>
  <div class="container booking__inner" data-reveal>
    <div class="booking__seal" aria-hidden="true">
      <CitrusMark size={56} />
      <p class="booking__seal-name">{property.wordmark}</p>
      <p class="booking__seal-place">
        {property.location.town} · {property.location.country[locale]}
      </p>
    </div>
    <div class="booking__text">
      <SectionHead title={tr.booking.title} id="booking-title" />
      <p class="booking__body">{tr.booking.body}</p>
      <div class="booking__actions">
        <a class="btn btn--primary" href={property.links.booking} target="_blank" rel="noopener noreferrer">
          {tr.booking.bookingCta}
          <span class="sr-only">({tr.footer.externalNote})</span>
        </a>
        {
          property.links.airbnb && (
            <a class="btn btn--ghost" href={property.links.airbnb} target="_blank" rel="noopener noreferrer">
              {tr.booking.airbnbCta}
              <span class="sr-only">({tr.footer.externalNote})</span>
            </a>
          )
        }
      </div>
      <p class="booking__note">
        {tr.booking.platformNote}
      </p>
      <div class="booking__practical">
        <h3>{tr.booking.practicalHeading}</h3>
        <p>{tr.booking.practical.join(' · ')}</p>
      </div>
      <p class="booking__instagram">
        {tr.booking.instagramLead}
        <a href={property.links.instagram} target="_blank" rel="noopener noreferrer">
          @{property.links.instagramHandle}
          <span class="sr-only">({tr.footer.externalNote})</span>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .booking {
    background: var(--c-peach);
  }

  .booking__inner {
    display: grid;
    gap: 2rem;
  }

  /* A set mark rather than an illustrated seal: the drawn citrus and the name, nothing else. */
  .booking__seal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .booking__seal-name {
    font-family: var(--font-serif);
    font-variation-settings: var(--display-axes-text);
    font-size: 2rem;
    line-height: 1;
  }

  .booking__seal-place {
    margin-top: -0.6rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }

  .booking__body {
    margin-top: 1.5rem;
    font-size: var(--text-lg);
    max-width: 42ch;
  }

  .booking__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .booking__actions :global(.btn) {
    width: 100%;
  }

  .booking__instagram {
    margin-top: 1.75rem;
    color: var(--c-ink-soft);
  }

  .booking__practical {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
  }

  .booking__practical h3 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }

  .booking__practical p {
    margin-top: 0.7rem;
    max-width: 46ch;
    font-size: var(--text-sm);
    color: var(--c-ink-soft);
  }

  .booking__note {
    margin-top: 1.25rem;
    color: var(--c-ink-soft);
    font-size: var(--text-sm);
  }

  .booking__instagram a {
    color: var(--c-ink);
    font-weight: 500;
  }

  @media (min-width: 40em) {
    .booking__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .booking__actions :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 64em) {
    .booking__inner {
      grid-template-columns: minmax(0, 1fr) 14rem;
      column-gap: 4rem;
      align-items: center;
    }

    .booking__text {
      grid-column: 1;
      grid-row: 1;
    }

    .booking__seal {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
    }
  }
</style>
