---
import { Picture } from 'astro:assets';
import HeroVideo from './HeroVideo.astro';
import MagneticLink from './MagneticLink.astro';
import { media } from '../content/media';
import { property } from '../config/property';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);

/** The view alone, photographed from the terrace: no furniture, just Petrovac and the sea. */
const photo = media.petrovacDusk;
const focal = `${photo.focal.x}% ${photo.focal.y}%`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    {
      property.heroVideo ? (
        <HeroVideo locale={locale} poster={photo} video={property.heroVideo} />
      ) : (
        <div class="frame hero__frame" style={`--focal: ${focal}`}>
          <Picture
            src={photo.src}
            alt={photo.alt[locale]}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1600, 1920, 2293]}
            sizes="100vw"
            layout="full-width"
            priority
          />
        </div>
      )
    }
  </div>

  <div class="container container--wide hero__content">
    <div class="hero__panel">
      <h1 id="hero-title" class="hero__title">{tr.hero.title} <em>{tr.hero.titleAccent}</em></h1>
      <p class="hero__place">{tr.hero.place}</p>
      <p class="hero__text">{tr.hero.text}</p>
      <div class="hero__actions" data-hero-cta>
        <MagneticLink class="hero__cta" href={property.links.booking} external>
          {tr.hero.ctaPrimary}
          <span class="sr-only">({tr.footer.externalNote})</span>
        </MagneticLink>
        {
          property.links.airbnb && (
            <a
              class="btn btn--outline-light hero__cta"
              href={property.links.airbnb}
              target="_blank"
              rel="noopener noreferrer"
            >
              {tr.booking.airbnbCta}
              <span class="sr-only">({tr.footer.externalNote})</span>
            </a>
          )
        }
        <a class="text-link hero__link" href={`#${tr.anchors.gallery}`}>
          {tr.hero.ctaSecondary}
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M3 8h9m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Full-bleed photograph of the view; the words sit low on the left over a soft dark gradient. */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(36rem, calc(100svh - var(--header-h)), 52rem);
    background: var(--c-adriatic);
    color: var(--c-paper);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__frame,
  .hero__media :global(.hero-video) {
    height: 100%;
    border-radius: 0;
    background: var(--c-adriatic);
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(14 30 36 / 0.06) 10%,
      rgb(14 30 36 / 0.22) 40%,
      rgb(14 30 36 / 0.82) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    padding-top: 6rem;
    padding-bottom: clamp(2rem, 5vw, 4.5rem);
  }

  .hero__panel {
    width: 100%;
    max-width: 44rem;
  }

  .hero__title {
    max-width: 12ch;
    font-size: clamp(2.75rem, 1.5rem + 3.6vw, 4.9rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--c-paper);
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.25);
  }

  .hero__title em {
    display: block;
    font-style: normal;
    color: var(--c-tangerine-on-dark);
  }

  .hero__place {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c-paper) 85%, transparent);
  }

  .hero__text {
    margin-top: 1rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    max-width: 40ch;
    color: var(--c-paper);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.25);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }

  .hero__actions :global(.hero__cta) {
    width: 100%;
  }

  .hero__link {
    color: var(--c-paper);
    border-color: color-mix(in srgb, var(--c-paper) 55%, transparent);
  }

  .hero__link:hover {
    color: var(--c-paper);
    border-color: var(--c-paper);
  }

  .hero :focus-visible {
    outline-color: var(--c-paper);
  }

  @media (min-width: 40em) {
    .hero__actions {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
    }

    .hero__actions :global(.hero__cta) {
      width: auto;
    }
  }

  @media (min-width: 64em) {
    /* Wider screens: darken the left edge behind the words, keep the sea on the right open. */
    .hero__media::after {
      background:
        linear-gradient(90deg, rgb(14 30 36 / 0.62), rgb(14 30 36 / 0.1) 65%),
        linear-gradient(to bottom, transparent 30%, rgb(14 30 36 / 0.6));
    }
  }

  /* Entrance: short, does not delay content. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__panel > * {
      animation: hero-rise 520ms var(--ease) both;
    }

    .hero__panel > :nth-child(2) {
      animation-delay: 60ms;
    }

    .hero__panel > :nth-child(3) {
      animation-delay: 120ms;
    }

    .hero__panel > :nth-child(4) {
      animation-delay: 180ms;
    }

    .hero__frame :global(img) {
      animation: hero-fade 700ms var(--ease) both;
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes hero-fade {
      from {
        opacity: 0.4;
      }

      to {
        opacity: 1;
      }
    }
  }
</style>
