---
import { Picture } from 'astro:assets';
import HeroVideo from './HeroVideo.astro';
import MagneticLink from './MagneticLink.astro';
import { media } from '../content/media';
import { property } from '../config/property';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const photo = media.terraceViewDay;
const focal = `${photo.focal.x}% ${photo.focal.y}%`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__panel">
    <h1 id="hero-title" class="hero__title">{tr.hero.title} <em>{tr.hero.titleAccent}</em></h1>
    <p class="hero__text">{tr.hero.text}</p>
    <div class="hero__actions" data-hero-cta>
      <MagneticLink
        class="hero__cta"
        href={property.links.booking}
        external
      >
        {tr.hero.ctaPrimary}
        <span class="sr-only">({tr.footer.externalNote})</span>
      </MagneticLink>
      <a class="text-link" href={`#${tr.anchors.gallery}`}>
        {tr.hero.ctaSecondary}
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M3 8h9m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </a>
    </div>
    <p class="hero__place">{tr.hero.place}</p>
  </div>

  <div class="hero__media">
    {
      property.heroVideo ? (
        <HeroVideo locale={locale} poster={photo} video={property.heroVideo} />
      ) : (
        <div class="frame hero__frame" style={`--focal: ${focal}`}>
          <Picture
            src={photo.src}
            alt={photo.alt[locale]}
            formats={['avif', 'webp']}
            widths={[480, 720, 960, 1200, 1448]}
            sizes="(min-width: 64em) 58vw, 100vw"
            layout="full-width"
            priority
          />
        </div>
      )
    }
    <p class="hero__caption">{tr.hero.caption}</p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--c-peach);
  }

  /* Mobile: the photograph first, tall enough to read the terrace and sea. */
  .hero__media {
    position: relative;
    order: -1;
  }

  .hero__frame {
    height: clamp(22rem, 66svh, 36rem);
    border-radius: 0;
  }

  .hero__caption {
    position: absolute;
    left: var(--gutter);
    bottom: 1rem;
    margin: 0;
    padding: 0.4rem 0.7rem;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--c-ink);
    background: color-mix(in srgb, var(--c-paper) 92%, transparent);
    border-radius: var(--radius);
    max-width: calc(100% - 2 * var(--gutter));
  }

  .hero__panel {
    padding: 2rem var(--gutter) 2.75rem;
  }

  .hero__title {
    max-width: 12ch;
    font-size: clamp(3.25rem, 5.2vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .hero__title em {
    display: block;
    font-style: normal;
    color: var(--c-burnt);
  }

  .hero__place {
    margin-top: 2.25rem;
    font-size: var(--text-sm);
    color: var(--c-ink-soft);
  }

  .hero__text {
    margin-top: 1.25rem;
    font-size: var(--text-lg);
    color: var(--c-ink-soft);
    max-width: 34ch;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero__actions :global(.hero__cta) {
    width: 100%;
  }

  @media (min-width: 40em) {
    .hero__actions {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .hero__actions :global(.hero__cta) {
      width: auto;
    }
  }

  /* Desktop: ivory title panel beside a large, carefully proportioned photograph. */
  @media (min-width: 64em) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      min-height: min(calc(100svh - var(--header-h)), 52rem);
    }

    .hero__media {
      order: 0;
      height: 100%;
    }

    .hero__frame {
      height: 100%;
      min-height: 34rem;
    }

    .hero__caption {
      left: 1.5rem;
      bottom: 1.5rem;
    }

    .hero__panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(3rem, 6vw, 6rem) clamp(2.5rem, 5vw, 5rem) clamp(3rem, 6vw, 6rem) var(--gutter);
    }

    .hero__panel > * {
      margin-left: max(0px, calc((100% - 34rem) / 2));
    }
  }

  @media (min-width: 90em) {
    .hero__panel {
      padding-left: max(var(--gutter), calc((100vw - var(--container-wide)) / 2));
    }
  }

  /* Entrance: short, does not delay content. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__panel > * {
      animation: hero-rise 520ms var(--ease) both;
    }

    .hero__panel > :nth-child(2) {
      animation-delay: 60ms;
    }

    .hero__panel > :nth-child(3) {
      animation-delay: 120ms;
    }

    .hero__panel > :nth-child(4) {
      animation-delay: 180ms;
    }

    .hero__frame :global(img) {
      animation: hero-fade 600ms var(--ease) both;
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes hero-fade {
      from {
        opacity: 0.4;
      }

      to {
        opacity: 1;
      }
    }
  }
</style>
