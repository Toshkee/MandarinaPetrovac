---
import { Picture } from 'astro:assets';
import HeroVideo from './HeroVideo.astro';
import { media } from '../content/media';
import { property } from '../config/property';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);

/** Lead with the experience itself: a seat on the terrace, above Petrovac and the sea. */
const photo = media.heroBalconyView;
const focal = `${photo.focal.x}% ${photo.focal.y}%`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    {
      property.heroVideo ? (
        <HeroVideo locale={locale} poster={photo} video={property.heroVideo} />
      ) : (
        <div class="frame hero__frame" style={`--focal: ${focal}`}>
          <Picture
            src={photo.src}
            alt={photo.alt[locale]}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="100vw"
            layout="full-width"
            quality={90}
            priority
          />
        </div>
      )
    }
  </div>

  <div class="container container--wide">
    <div class="hero__panel">
      <p class="hero__place">{tr.hero.place}</p>
      <h1 id="hero-title" class="hero__title">{tr.hero.title} <em>{tr.hero.titleAccent}</em></h1>
      <p class="hero__text">{tr.hero.text}</p>
      <div class="hero__actions" data-hero-cta>
        <a class="btn btn--primary hero__cta" href={property.links.booking} target="_blank" rel="noopener noreferrer">
          {tr.hero.ctaPrimary}
          <span class="sr-only">({tr.footer.externalNote})</span>
        </a>
        <a class="text-link hero__link" href={`#${tr.anchors.gallery}`}>
          {tr.hero.ctaSecondary}
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M3 8h9m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * The photograph runs full width and keeps its own colour: no scrim, no text shadow.
   * The words sit underneath it on paper, so the bottom edge of the picture stays a
   * straight line across the viewport and the contrast is settled by the layout.
   */
  .hero {
    position: relative;
    background: var(--c-paper);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  /* The media box owns the height so the poster and the optional video both fill it. */
  .hero__media {
    position: relative;
    height: clamp(17rem, 56svh, 36rem);
  }

  .hero__frame,
  .hero__media :global(.hero-video) {
    height: 100%;
    border-radius: 0;
    background: var(--c-adriatic);
  }

  .hero__panel {
    max-width: 46rem;
    padding-top: clamp(1.75rem, 4vw, 3rem);
  }

  .hero__place {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-burnt);
  }

  .hero__title {
    margin-top: 0.9rem;
    max-width: 12ch;
    font-size: clamp(2.75rem, 1.5rem + 3.6vw, 4.9rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .hero__title em {
    display: block;
    font-style: normal;
    color: var(--c-tangerine);
  }

  .hero__text {
    margin-top: 1.25rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    max-width: 38ch;
    color: var(--c-ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }

  .hero__actions :global(.hero__cta) {
    width: 100%;
  }

  @media (min-width: 40em) {
    .hero__actions {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
    }

    .hero__actions :global(.hero__cta) {
      width: auto;
    }
  }

  /* Entrance: one short fade on the block, nothing staggered. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__panel {
      animation: hero-rise 560ms var(--ease) both;
    }

    .hero__frame :global(img) {
      animation: hero-fade 700ms var(--ease) both;
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes hero-fade {
      from {
        opacity: 0.4;
      }

      to {
        opacity: 1;
      }
    }
  }
</style>
