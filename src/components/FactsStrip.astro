---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const facts = [tr.facts.guests, tr.facts.bedroom, tr.facts.bathroom, tr.facts.size, tr.facts.wifi, tr.facts.parking];
---

<section class="facts" aria-labelledby="facts-title">
  <div class="container container--wide facts__inner">
    <p class="facts__label" id="facts-title">{tr.facts.heading}</p>
    <ul class="facts__list">
      {
        facts.map((fact) => (
          <li class="facts__item">
            <span>{fact}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .facts {
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-line);
  }

  .facts__inner {
    padding-block: 1.4rem;
  }

  .facts__label {
    margin-bottom: 1rem;
    color: var(--c-burnt);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .facts__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.25rem;
  }

  .facts__item {
    min-width: 0;
    padding-block: 0.7rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-ink);
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  @media (min-width: 48em) {
    .facts__inner {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 1.75rem;
      padding-block: 1rem;
    }

    .facts__label {
      margin: 0;
      padding-right: 1.75rem;
      border-right: 1px solid var(--c-line);
      white-space: nowrap;
    }

    .facts__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 75em) {
    .facts__list {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
