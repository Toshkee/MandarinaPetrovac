---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const facts = [tr.facts.guests, tr.facts.bedroom, tr.facts.bathroom, tr.facts.size, tr.facts.wifi, tr.facts.parking];
---

<section class="facts" aria-labelledby="facts-title">
  <div class="container container--wide facts__inner">
    <p class="facts__label" id="facts-title">{tr.facts.heading}</p>
    <ul class="facts__list">
      {facts.map((fact) => <li class="facts__item">{fact}</li>)}
    </ul>
  </div>
</section>

<style>
  /* One running line under the hero rather than a six-cell table of rules. */
  .facts {
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-line);
  }

  .facts__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1.5rem;
    padding-block: 1.25rem;
  }

  .facts__label {
    color: var(--c-burnt);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .facts__list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 0.35rem;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .facts__item:not(:last-child)::after {
    content: '·';
    margin-inline: 0.7rem;
    color: var(--c-tangerine);
  }
</style>
