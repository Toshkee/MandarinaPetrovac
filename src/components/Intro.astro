---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { media } from '../content/media';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const photo = media.livingRoomFromHall;
const focal = `${photo.focal.x}% ${photo.focal.y}%`;
---

<section class="intro section" id={tr.anchors.apartment} aria-labelledby="intro-title">
  <div class="container intro__grid">
    <div class="intro__text" data-reveal>
      <SectionHead title={tr.intro.title} id="intro-title" />
      <div class="intro__body prose">
        {tr.intro.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="intro__details">
        <h3 class="intro__details-title">{tr.intro.detailsHeading}</h3>
        <ul class="intro__list">
          {tr.intro.details.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <figure class="intro__figure" data-reveal>
      <div class="frame frame--4x3" style={`--focal: ${focal}`}>
        <Picture
          src={photo.src}
          alt={photo.alt[locale]}
          formats={['avif', 'webp']}
          widths={[480, 640, 800, 960, 1200]}
          sizes="(min-width: 64em) 52vw, 100vw"
          layout="full-width"
          loading="lazy"
        />
      </div>
      <figcaption>{photo.caption[locale]}</figcaption>
    </figure>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    gap: 2.5rem;
  }

  .intro__body {
    margin-top: 1.5rem;
  }

  .intro__details {
    margin-top: 2.25rem;
    padding: 1.5rem;
    background: #f0ece1;
    border-radius: 12px;
  }

  .intro__details-title {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--c-ink-soft);
    margin-bottom: 0.75rem;
  }

  .intro__list {
    display: grid;
    gap: 0.5rem 1.25rem;
  }

  .intro__list li {
    padding: 0.4rem 0 0.4rem 1.1rem;
    position: relative;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .intro__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.95rem;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--c-olive);
  }

  .intro__figure {
    padding: 0.75rem 0.75rem 1rem;
    background: #fffdf8;
    box-shadow: 0 12px 36px rgb(48 46 40 / 8%);
  }

  .intro__figure figcaption {
    padding-inline: 0.35rem;
  }

  @media (min-width: 48em) {
    .intro__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
  }

  @media (min-width: 64em) {
    .intro__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }

    .intro__figure {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      margin-top: 2rem;
      rotate: 2deg;
    }
  }
</style>
